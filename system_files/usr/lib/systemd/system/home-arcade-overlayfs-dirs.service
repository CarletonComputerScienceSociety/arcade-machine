[Unit]
Description=Prepare directories for /home/arcade OverlayFS
DefaultDependencies=no
Conflicts=umount.target
Before=local-fs.target overlay.mount

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/bin/mkdir -p /run/overlay/arcade-home
ExecStartPre=/bin/mount -t tmpfs -o size=1G tmpfs ExecStartPre=/bin/mkdir -p /run/overlay/arcade-home
ExecStartPre=/bin/mkdir -p /run/overlay/arcade-home/upper /run/overlay/arcade-home/work
ExecStartPre=/bin/chown arcade: /run/overlay/arcade-home/upper
ExecStart=/bin/chmod 750 /run/overlay/arcade-home/upper

[Install]
WantedBy=local-fs.target
