[Unit]
Description=Arcade home screen
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/share/arcade/RetroArch.AppImage --config /usr/share/arcade/RetroArch/retroarch.cfg.base --appendconfig %h/.config/retroarch/retroarch.cfg.overlay
Restart=always
RestartSec=0
KillSignal=SIGKILL

[Install]
WantedBy=graphical-session.target
